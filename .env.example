# Credenciales locales. Copia este fichero a `.env` y rellena los valores.
# `.env` esta en .gitignore: nunca se versiona.
#
# La ventana puede escribir estas claves por ti (Avisos -> Correo, SMS y móvil),
# sin que tengas que editar el fichero a mano.

# --- Correo (SMTP) ---------------------------------------------------------
# Para Gmail hace falta una "contrasena de aplicacion", no la del correo:
#   Cuenta de Google -> Seguridad -> Verificacion en dos pasos -> Contrasenas
#   de aplicaciones. Sin la verificacion en dos pasos esa opcion no aparece.
# Otras cuentas (Outlook, servidor propio) admiten su contrasena habitual o
# una especifica de SMTP.

ALARM_SMTP_USER=cuenta@gmail.com
ALARM_SMTP_PASSWORD=pon-aqui-la-contrasena-de-aplicacion

# --- SMS con Twilio --------------------------------------------------------
# Console de Twilio -> Account Info: Account SID y Auth Token.
# El numero remitente debe estar comprado o verificado en la cuenta.

ALARM_TWILIO_SID=
ALARM_TWILIO_TOKEN=

# --- Avisos push con ntfy --------------------------------------------------
# Solo para un servidor ntfy propio que exija autenticacion. En el servicio
# publico (ntfy.sh) se deja vacio: el tema actua como secreto compartido.
# El token se crea en el servidor: `ntfy user add` / `ntfy token add`.

ALARM_NTFY_TOKEN=

# --- Mando remoto por ntfy ------------------------------------------------
# Clave que se escribe en el tema de mando: "clave armar". Minimo 12
# caracteres; la ventana la genera y la guarda por ti.
ALARM_REMOTE_KEY=

# Alternativa (o segundo factor): secreto TOTP en base32 para Google
# Authenticator, Authy o similar. Con TOTP configurado la clave deja de
# valer. La ventana tambien lo genera y muestra la URI otpauth://.
ALARM_REMOTE_TOTP=
